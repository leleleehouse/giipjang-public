generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url = "file:./ledger.db"
}
model Upload {
  id Int @id @default(autoincrement())
  name String
  hash String @unique
  createdAt DateTime @default(now())
  links Source[]
}
model Transaction {
  id Int @id @default(autoincrement())
  date String
  asset String
  category String
  subcategory String
  description String
  amount Int
  type String
  memo String
  raw String
  fingerprint String
  oneOff Boolean @default(false)
  sources Source[]
}
model Source {
  id Int @id @default(autoincrement())
  uploadId Int
  transactionId Int
  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}
model Budget {
  id Int @id @default(autoincrement())
  month String
  category String
  amount Int
  @@unique([month, category])
}
model Goal {
  id Int @id @default(autoincrement())
  asset String @unique
  amount Int
}

model InvestmentAccount {
  id Int @id @default(autoincrement())
  name String
  institution String @default("")
  type String
  openedAt String @default("")
  maturity String @default("")
  memo String @default("")
  initialPrincipal Int?
  principalDate String @default("")
  rate Float @default(0)
  reinvest Boolean @default(false)
  savingsKind String @default("예금")
  depositDay Int @default(1)
  maturityGoal Int?
  checks InvestmentCheck[]
  holdings InvestmentHolding[]
  flows InvestmentFlow[]
  snapshots InvestmentSnapshot[]
  targets InvestmentTarget[]
}
model InvestmentFlow {
  id Int @id @default(autoincrement())
  accountId Int
  date String
  type String
  amount Int
  memo String @default("")
  account InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}
model InvestmentSnapshot {
  id Int @id @default(autoincrement())
  accountId Int
  date String
  amount Int
  memo String @default("")
  account InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, date])
}
model InvestmentTarget {
  id Int @id @default(autoincrement())
  accountId Int
  month String
  amount Int
  account InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, month])
}

model InvestmentHolding {
  id Int @id @default(autoincrement())
  accountId Int
  symbol String
  name String @default("")
  currency String
  quantity String
  averagePrice String
  purchaseDate String @default("")
  account InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model InvestmentCheck {
  id Int @id @default(autoincrement())
  accountId Int
  month String
  amount Int
  flowId Int? @unique
  autoFlow Boolean @default(false)
  account InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@unique([accountId, month])
}

model FavoriteSecurity {
  id Int @id @default(autoincrement())
  symbol String
  name String @default("")
  currency String
  @@unique([symbol, currency])
}
